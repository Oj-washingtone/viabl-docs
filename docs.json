{
    "name": "viabl",
    "url": "http://viabl.dev",
    "basePath": "/docs",
    "favicon": "/favicon.png",
    "defaultVersion": "v2",
    "logo": {
        "dark": "/logo/dark.svg",
        "light": "/logo/light.svg",
        "href": "https://viabl.dev"
    },
    "colors": {
        "primary": "#ff5800",
        "light": "#ff5800",
        "dark": "#ff7733",
        "background": {
            "dark": "radial-gradient(ellipse 60% 10% at 50% -5%, rgba(255,88,0,0.2), transparent), #0c0d0f",
            "light": "radial-gradient(ellipse 60% 25% at 50% -5%, rgba(255,88,0,0.08), transparent), #ffffff"
        },
        "anchors": {
            "from": "#ff5800",
            "to": "#ff5800"
        }
    },
    "font": {
        "headings": {
            "family": "Geist",
            "url": "https://cdn.jsdelivr.net/npm/geist@1.3.0/dist/fonts/geist-sans/style.css"
        },
        "body": {
            "family": "Geist",
            "url": "https://cdn.jsdelivr.net/npm/geist@1.3.0/dist/fonts/geist-sans/style.css"
        }
    },
    "search": {
        "prompt": "Search doc..."
    },
    "topbarCtaButton": {
        "name": "Get Started",
        "url": "/quickstart/welcome-to-viabl",
        "style": "fill",
        "arrow": true,
        "icon": "Rocket",
        "blank": false
    },
    "topbarLinks": [
        {
            "name": "Talk to us",
            "url": "https://example.com/support",
            "blank": true
        }
    ],
    "tabs": [
        {
            "name": "Doc",
            "url": "quickstart",
            "icon": "BookOpen"
        },
        {
            "name": "Api docs",
            "url": "api-reference",
            "icon": "Code2"
        },
        {
            "name": "Feedback",
            "url": "support",
            "icon": "Lightbulb",
            "anchor": true
        }
    ],
    "navigation": {
        "quickstart": [
            {
                "group": "Get started",
                "icon": "Rocket",
                "pages": [
                    "quickstart/welcome-to-viabl",
                    "quickstart/quickstart",
                    "quickstart/configuration",
                    "quickstart/pages",
                    "quickstart/navigation",
                    "quickstart/seo",
                    "quickstart/ai-assistant"
                ]
            },
            {
                "group": "Components",
                "icon": "Layers",
                "pages": [
                    "components/overview",
                    "components/cards",
                    "components/steps",
                    "components/accordion",
                    "components/tabs",
                    "components/callouts",
                    "components/badge",
                    "components/image",
                    "components/tooltip",
                    "components/expandable",
                    "components/update",
                    "components/response-fields"
                ]
            },
            {
                "group": "Guides",
                "icon": "Cloud",
                "pages": [
                    "guides/overview",
                    "guides/docker",
                    "guides/github-actions",
                    "guides/host-under-subpath"
                ]
            }
        ],
        "api-reference": [
            {
                "group": "Api Rerefence",
                "icon": "Rocket",
                "pages": [
                    "api-reference/overview",
                    {
                        "group": "Examples",
                        "pages": [
                            "api-reference/authentication",
                            "api-reference/user-apis",
                            "api-reference/project"
                        ]
                    }
                ]
            }
        ],
        "support": [
            "support/feedback"
        ],
        "all": [
            "updates/changelog"
        ]
    },
    "footerSocials": {
        "twitter": "https://twitter.com/viablkit",
        "github": "https://github.com/Oj-washingtone/viabl-cli",
        "linkedin": "https://linkedin.com/company/viablkit",
        "website": "https://viabl.dev",
        "discord": "https://discord.gg/JyBMrk4G"
    },
    "seo": {
        "indexHiding": false,
        "og": {
            "title": "Viabl documentation",
            "description": "Ship Documentation easily with viabl",
            "image": "/images/hero-white.png"
        }
    },
    "ai": {
        "provider": "anthropic",
        "apiKey": "${ANTHROPIC_API_KEY}",
        "suggestedQuestions": [
            "How do i get started with viabl?",
            "How can i configure and customize my docs ?",
            "How do i deploy my docs ?"
        ],
        "rules": []
    },
    "feedback": {
        "thumbsRating": true,
        "suggestEdit": true,
        "raiseIssue": true,
        "webhook": "http://where-feedback-is-sent",
        "githubRepo": "https://github.com/Oj-washingtone/viabl-docs"
    }
}